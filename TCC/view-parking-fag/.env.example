# Leave empty to use the same-origin /api proxy. For a separately hosted frontend, use the Java URL.
VITE_API_BASE_URL=
JAVA_PROXY_URL=http://127.0.0.1:8080
# WebSocket + consulta de segurança a cada 15s; retry HTTP de 30s.
# npm run serve lê variáveis do processo: PUBLIC_BIND=127.0.0.1 e PUBLIC_PORT=4173.
